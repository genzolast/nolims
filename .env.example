# ---------------------------------------------------------------------------
# Contoh konfigurasi personal AI gateway.
# Salin dahulu:  cp .env.example .env
# Lalu isi nilainya. File .env TIDAK boleh di-commit (sudah ada di .gitignore).
# ---------------------------------------------------------------------------

# Master key proxy: satu kunci untuk semua pemakaian gateway.
# placeholder -> bila kosong, install.sh akan mengisi otomatis random hex 32 byte.
MASTER_KEY=

# Google AI Studio (Gemini) -> https://aistudio.google.com/apikey
GEMINI_KEY=

# OpenRouter -> https://openrouter.ai/keys
OPENROUTER_KEY=

# AIHubMix -> https://aihubmix.com (menu API Keys / token)
AIHUBMIX_KEY=

# Token bot Telegram dari @BotFather (opsional, hanya untuk add-on bot AI)
TELEGRAM_BOT_TOKEN=

# Token bot Telegram untuk add-on bot pemeriksa tautan (link-tools).
# Pakai bot TERPISAH dari TELEGRAM_BOT_TOKEN: satu token hanya boleh punya satu
# getUpdates aktif — memakai token yang sama akan memicu error 409 Conflict.
LINKBOT_TOKEN=

# Daftar chat id yang diizinkan memakai bot, pisahkan dengan koma.
# Contoh: ALLOWED_CHATS=123456789,-1001122334455
# Chat id pribadi bisa didapat dari @userinfobot atau @getidsbot.
ALLOWED_CHATS=
